# Application Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/testing_playground_dev
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/testing_playground_test

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=1h

# Cookie Configuration
COOKIE_NAME=auth_token
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=strict
